{
  "$schema": "https://typedoc.org/schema.json",

  // Configuration for the published frontend API reference. Generated in frontend CI by
  // .github/scripts/docs/build-frontend-api.sh and shipped as an artifact the docs pipeline
  // downloads, the same way the Vitest coverage report travels. `out` is git-ignored: it is a
  // build product, never committed.

  // "expand" walks the directory rather than treating it as one entry point, so every module
  // under src/app is documented instead of only what an index barrel would re-export.
  "entryPoints": ["src/app"],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.app.json",

  // Specs and the test-support helpers are not API surface; tsconfig.app.json already excludes
  // specs from the app build, and this keeps them out of the reference on the expand walk too.
  "exclude": ["**/*.spec.ts", "**/testing/**"],

  "out": "typedoc-dist",

  "name": "Bestandskontrolle / StockEase - Frontend API",
  "readme": "none",
  "hideGenerator": true,

  // The back-to-docs link every page on the docs site carries.
  "navigationLinks": {
    "Docs home": "/stockease/"
  },

  "excludePrivate": true,
  "excludeExternals": true,

  // src/app/core/api/api-types.ts is generated from the OpenAPI spec by openapi-typescript, which
  // emits the schema descriptions as `@description` - the OpenAPI generator's tag dialect, not one
  // TypeDoc knows. That single unknown tag was 319 of the 337 warnings this build used to print.
  // The file must not be hand-edited (its header says so), so the tag is declared here instead.
  //
  // Setting blockTags REPLACES TypeDoc's default list rather than extending it, so all 42 defaults
  // for the pinned 0.28.20 are repeated below - taken from the schema the package itself ships,
  // node_modules/typedoc/typedoc-config.schema.json. Dropping one would silently stop @param or
  // @returns from being parsed. Re-copy this list when TypeDoc is upgraded.
  "blockTags": [
    "@defaultValue", "@deprecated", "@example", "@jsx", "@param", "@privateRemarks",
    "@remarks", "@returns", "@see", "@throws", "@typeParam", "@author",
    "@callback", "@category", "@categoryDescription", "@default", "@document", "@extends",
    "@augments", "@yields", "@group", "@groupDescription", "@import", "@inheritDoc",
    "@license", "@module", "@mergeModuleWith", "@prop", "@property", "@return",
    "@satisfies", "@since", "@sortStrategy", "@template", "@this", "@type",
    "@typedef", "@summary", "@preventInline", "@inlineType", "@preventExpand", "@expandType",
    "@description"
  ],

  // Two comments link to symbols that are real but live outside this project's documentation.
  // Mapped to their own official pages rather than suppressed: the link then resolves to
  // somewhere useful, which is what the comment meant in the first place.
  "externalSymbolLinkMappings": {
    "typescript": {
      "Error.message": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Error/message"
    },
    "rxjs": {
      "switchMap": "https://rxjs.dev/api/operators/switchMap"
    }
  },

  // Form shapes that are deliberately internal to their components: naming them here states that
  // "referenced but not documented" is the intent, rather than exporting them to quiet a warning.
  //
  // The four that follow are view-state unions referenced only by PROTECTED members, which this
  // config publishes because it excludes private and not protected. That reference is what warns
  // once the type stops being exported; the type itself is internal to its component, so the
  // intent is recorded here rather than by re-widening the module surface.
  "intentionallyNotExported": [
    "MovementForm",
    "PricePoint",
    "HistoryMode",
    "CardView",
    "ReportView",
    "ReportPeriod"
  ]
}
