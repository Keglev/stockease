/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    /* Set explicitly because outDir is set: TypeScript 6 no longer infers the output layout
       from the common source directory, and without this it reports TS5011. */
    "rootDir": "./src",
    /* "node" is here for the translation-parity spec, which reads the real locale files from
       disk; specs run in Node under Vitest, so the built app is unaffected. */
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts"
  ]
}
